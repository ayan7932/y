        "# C2\n",
        "def count_over(*values, limit=100):\n",
        "    \"\"\"Return how many values are over the limit.\"\"\"\n",
        "    count = 0\n",
        "\n",
        "    for value in values:\n",
        "        if value > limit:\n",
        "            count += 1\n",
        "\n",
        "    return count\n",
        "\n",
        "\n",
        "print(count_over(87, 120, 45, 101))\n",
        "print(count_over(87, 120, 45, 101, limit=50))\n",
        "print(count_over())"
